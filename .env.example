# Copia este archivo a .env y cambia los valores. Nunca subas .env al repositorio.

# Base de datos
DB_NAME=pos_hibrido
DB_USER=pos_user
DB_PASSWORD=cambia_esta_clave
DB_URL=jdbc:postgresql://postgres-db:5432/pos_hibrido

# Backend
SERVER_PORT=8080
# Mínimo 32 caracteres. Genera uno con: openssl rand -base64 48
JWT_SECRET=
CORS_ALLOWED_ORIGINS=http://localhost:4200
# true en producción (HTTPS). En local por http://localhost los navegadores aceptan cookies Secure.
REFRESH_COOKIE_SECURE=true
# Swagger UI en /swagger-ui.html (solo desarrollo)
OPENAPI_ENABLED=true
# Correo de tu cuenta YA registrada: al reiniciar el backend queda como administrador de plataforma
# (http://localhost:4200/plataforma). Varios: separados por coma.
PLATFORM_ADMIN_EMAILS=
