# Copia este archivo a .env y cambia los valores. Nunca subas .env al repositorio.

# Base de datos
DB_NAME=pos_hibrido
DB_USER=pos_user
DB_PASSWORD=cambia_esta_clave
DB_URL=jdbc:postgresql://postgres-db:5432/pos_hibrido

# Backend
SERVER_PORT=8080
# Mínimo 32 caracteres. Genera uno con: openssl rand -base64 48
JWT_SECRET=
CORS_ALLOWED_ORIGINS=http://localhost:4200
# true en producción (HTTPS). En local por http://localhost los navegadores aceptan cookies Secure.
REFRESH_COOKIE_SECURE=true
# Swagger UI en /swagger-ui.html (solo desarrollo)
OPENAPI_ENABLED=true
# Correo de tu cuenta YA registrada: al reiniciar el backend queda como administrador de plataforma
# (http://localhost:4200/plataforma). Varios: separados por coma.
PLATFORM_ADMIN_EMAILS=

# Correos. Sin RESEND_API_KEY los correos llegan al buzón de prueba: http://localhost:8025 (Mailpit).
# Con la clave de Resend salen de verdad (sin dominio verificado, Resend solo entrega a tu propio correo).
RESEND_API_KEY=
MAIL_FROM=POS Híbrido <onboarding@resend.dev>
# Dirección de la app para armar los enlaces de los correos
APP_PUBLIC_URL=http://localhost:4200
# Confirmar el correo antes de crear un negocio (false solo para pruebas automáticas)
EMAIL_VERIFICATION_REQUIRED=true
