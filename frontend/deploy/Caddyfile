# Caddy en producción: HTTPS automático (Let's Encrypt), la app Angular y el API en el mismo dominio.
# El navegador habla solo con este dominio, así la cookie de refresh (SameSite=Strict) funciona sin CORS.
#
# Variables (las pone docker-compose.prod.yml desde .env):
#   DOMAIN      pos.midominio.com  (o http://localhost para probar sin certificado)
#   ACME_EMAIL  correo para avisos de Let's Encrypt (vencimiento de certificados)

{
	email {$ACME_EMAIL}
}

{$DOMAIN} {
	# Sin comprimir los avisos en tiempo real (SSE, Fase 12b-4): comprimidos, Caddy los guardaría hasta llenar un bloque.
	@compress not path /api/v1/dining/events
	encode @compress zstd gzip

	header {
		# Sin "Server: Caddy" (no anunciar el software).
		-Server
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "same-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		Cross-Origin-Opener-Policy "same-origin"
		# style-src necesita 'unsafe-inline': Angular inserta los <style> de cada componente en tiempo de ejecución.
		# Scripts: solo archivos propios (por eso el modo oscuro inicial está en theme-init.js).
		# connect-src 127.0.0.1:17777: el programa XASKA Impresora del computador de la caja (decisión 286).
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' http://127.0.0.1:17777; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
	}

	# API: solo /api. Actuator y Swagger del backend no quedan expuestos a internet.
	handle /api/* {
		# 12 MB: el PDF de una factura (hasta 10 MB, decisión 295) más el sobre del formulario.
		request_body {
			max_size 12MB
		}
		reverse_proxy backend:8080 {
			# Si el backend se reinicia (actualización), reintenta unos segundos antes de responder 502.
			lb_try_duration 10s
		}
	}

	# Estado para monitores externos (UptimeRobot…): solo {"status":"UP"} o "DOWN", sin detalles.
	handle /healthz {
		rewrite * /actuator/health
		reverse_proxy backend:8080
	}

	handle {
		root * /srv

		# Archivos con huella en el nombre (main-ABCD1234.js) que existen: no cambian nunca, caché de un año.
		@hashed {
			path_regexp hashed -[A-Z0-9]{8}\.(js|css|woff2?|ttf|eot|svg)$
			file
		}
		header @hashed Cache-Control "public, max-age=31536000, immutable"
		# Todo lo demás (index.html, theme-init.js, iconos): se revalida en cada carga para ver la versión nueva.
		@fresh not path_regexp -[A-Z0-9]{8}\.(js|css|woff2?|ttf|eot|svg)$
		header @fresh Cache-Control "no-cache"

		# Rutas de Angular (/app/caja, /pos…): sin extensión y sin archivo → index.html.
		# Un archivo con extensión que no existe (p. ej. un chunk de otra versión) da 404, no index.html:
		# así el navegador no guarda HTML como si fuera JavaScript.
		@spa {
			not file
			not path_regexp \.[A-Za-z0-9]+$
		}
		rewrite @spa /index.html
		# Caddy no conoce la extensión .webmanifest: sin esto saldría como texto plano.
		header /manifest.webmanifest Content-Type "application/manifest+json"
		file_server
	}
}
