{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "updateMode": "prefetch",
      "resources": {
        "files": ["/favicon.ico", "/favicon.svg", "/index.html", "/manifest.webmanifest", "/theme-init.js", "/*.css", "/*.js"]
      }
    },
    {
      "name": "assets",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": ["/fonts/**", "/*.png", "/*.svg", "/xaska-ia.svg", "/**/*.(woff|woff2|ttf)"]
      }
    }
  ],
  "navigationUrls": [
    "/**",
    "!/api/**",
    "!/healthz",
    "!/descargas/**",
    "!/mail/**",
    "!/**/*.*"
  ]
}
