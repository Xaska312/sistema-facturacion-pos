# Secretos y entorno local
.env
*.env.local

# Logs y temporales
*.log
logs/
tmp/

# IDEs / SO
.idea/
*.iml
.DS_Store
Thumbs.db

# Node en la raíz (el frontend tiene su propio .gitignore)
node_modules/

# Parches recibidos para aplicar con git am
*.patch

# Resultados de Playwright (e2e)
test-results/
playwright-report/

# Producción: acceso a Google Drive y claves de cifrado de los respaldos
deploy/rclone/*
!deploy/rclone/README.md

# Resultados de la prueba de carga (k6)
loadtest/resultados/*
!loadtest/resultados/.gitkeep
