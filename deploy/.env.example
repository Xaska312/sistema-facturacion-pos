# Configuración de producción. En el servidor: cp .env.example .env && nano .env
# .env tiene claves: nunca se sube al repositorio. Permisos recomendados: chmod 600 .env
# Claves aleatorias: openssl rand -base64 48 | tr -d '/+=' | cut -c1-40

# --- Dominio y HTTPS ---
# Solo el nombre, sin https:// (debe apuntar a la IP del servidor con un registro A).
DOMAIN=app.xaska.co
# Correo para los avisos de Let's Encrypt.
ACME_EMAIL=tu-correo@ejemplo.com

# --- Imágenes (GitHub Container Registry) ---
# Dueño del repositorio en minúsculas.
GHCR_OWNER=xaska312
# "latest" (último main con CI en verde) o una versión fija, p. ej. 0.7.0 (recomendado: sabes qué corre).
APP_VERSION=latest

# --- Base de datos ---
DB_NAME=pos_hibrido
# Superusuario: solo para respaldos y administración.
POSTGRES_ADMIN_USER=pos_admin
POSTGRES_ADMIN_PASSWORD=
# Usuario de la aplicación (sin privilegios de superusuario).
DB_USER=pos_app
DB_PASSWORD=

# --- Backend ---
# Mínimo 32 caracteres. Uno NUEVO para producción (nunca el de desarrollo ni uno compartido por chat).
JWT_SECRET=
# Correo de tu cuenta YA registrada en la app: al reiniciar el backend queda como administrador de plataforma
# (consola /plataforma). Varios: separados por coma. Regístrate primero y luego llénalo.
PLATFORM_ADMIN_EMAILS=
# Límite de solicitudes por usuario y minuto (general y para exportar/importar).
RATE_LIMIT_API=300
RATE_LIMIT_HEAVY=20

# --- Correos (ver docs/DESPLIEGUE.md, sección 13) ---
# Opción A, piloto: Gmail por SMTP con una "contraseña de aplicación" (no la contraseña normal).
# MAIL_FROM debe ser esa misma cuenta de Gmail (Gmail cambia cualquier otro remitente). Unos 500 correos al día.
SMTP_HOST=
# SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# Opción B, al abrir: Resend con soporte@xaska.co. Clave de https://resend.com (API Keys, "Sending access").
# Con clave, Resend gana sobre SMTP. Sin ninguna de las dos, los correos quedan en el log.
RESEND_API_KEY=
# Remitente: tu Gmail en la opción A (XASKA POS <tucuenta@gmail.com>) o tu dominio verificado en la B.
MAIL_FROM=XASKA POS <no-responder@xaska.co>
# Dirección de la app en los enlaces de los correos (por defecto https://DOMAIN).
# APP_PUBLIC_URL=https://app.xaska.co

# --- Suscripciones ---
# Cómo pagar: sale en la app y en los correos de vencimiento. Sin datos de cuentas que no quieras publicar.
SUBSCRIPTION_PAYMENT_INSTRUCTIONS=Escríbenos a soporte@xaska.co para renovar tu plan.

# --- Respaldos ---
# Remoto cifrado de rclone (ver docs/DESPLIEGUE.md, paso 6). Vacío = solo copias en el servidor.
BACKUP_REMOTE=posdrive-crypt:
# Zona horaria de los horarios de respaldo.
TZ=America/Bogota
# Respaldo diario a las 3:30 a. m. y prueba de restauración los domingos a las 5:00 a. m.
BACKUP_CRON=30 3 * * *
RESTORE_TEST_CRON=0 5 * * 0
# Copias en el servidor y días que se guardan en la nube.
BACKUP_KEEP_LOCAL=7
BACKUP_KEEP_DAILY_DAYS=30
BACKUP_KEEP_MONTHLY_DAYS=400
# Opcional: URLs de healthchecks.io (gratis) para recibir un correo si un respaldo falla o no corre.
BACKUP_PING_URL=
RESTORE_TEST_PING_URL=

# --- Solo para probar el modo producción en tu equipo (no usar en el servidor) ---
# CADDY_SITE=http://localhost
# HTTP_PORT=8081
# HTTPS_PORT=8443
# CORS_ALLOWED_ORIGINS=http://localhost:8081
# APP_PUBLIC_URL=http://localhost:8081
